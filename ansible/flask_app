server {
    listen 80;
    server_name _; # Приймати запити на будь-який IP або домен цього сервера

    location / {
        proxy_pass http://127.0.0.1:5000; # Перекидаємо все на Flask
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
